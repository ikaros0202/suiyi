root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Frozen imports retain their original bytes and layout.
[随译Suiyi-V1开发指导.md]
end_of_line = unset
insert_final_newline = unset

[随译Suiyi-项目基线.md]
end_of_line = unset
insert_final_newline = unset

[docs/design/original/*.html]
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
